# ==============================================================================
# FARM CONNECT ESWATINI — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' and replace the placeholder values with your real credentials.
# Note: Variables prefixed with VITE_ are exposed to the client-side bundle.

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# ------------------------------------------------------------------------------
# 2. MTN MOBILE MONEY (MoMo) OPEN API (ESWATINI)
# ------------------------------------------------------------------------------
# Developer Portal: https://momodeveloper.mtn.com
# Environment: 'sandbox' for testing, 'production' for live payments
VITE_MTN_MOMO_ENVIRONMENT=sandbox
VITE_MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Consumer Key & Secret obtained from your MTN MoMo API User provisioning
VITE_MTN_MOMO_CONSUMER_KEY=your_mtn_momo_consumer_key_or_api_user
VITE_MTN_MOMO_CONSUMER_SECRET=your_mtn_momo_consumer_secret_or_api_key

# Primary Subscription Key from your Products (e.g. Collections)
VITE_MTN_MOMO_PRIMARY_KEY=your_mtn_momo_primary_subscription_key
VITE_MTN_MOMO_TARGET_ENV=sandbox
VITE_MTN_MOMO_CURRENCY=SZL

# Custom Callback URL for MTN MoMo Webhook / Transaction Status updates
# When creating your API User or Subscription, paste this callback URL on the MTN portal:
# For Netlify Production: https://<your-netlify-subdomain>.netlify.app/api/momo-callback
# For Local Dev / Webhook Tunnel: https://your-domain.com/api/momo-callback
VITE_MTN_MOMO_CALLBACK_URL=https://farmconnect-eswatini.netlify.app/api/momo-callback

# ------------------------------------------------------------------------------
# 3. DPO PAY (DIRECT PAY ONLINE / D-PAY) SANDBOX API
# ------------------------------------------------------------------------------
# Handles Visa, Mastercard, American Express & regional debit card settlements
# Portal: https://secure.3gdirectpay.com / https://dpogroup.com
VITE_DPO_PAY_BASE_URL=https://secure.3gdirectpay.com/API/v6/
VITE_DPO_COMPANY_TOKEN=your_dpo_company_token
VITE_DPO_SERVICE_TYPE=3854
VITE_DPO_API_KEY=your_dpo_sandbox_api_key

# DPO Pay Return / Callback URL after card authorization completes
VITE_DPO_CALLBACK_URL=https://farmconnect-eswatini.netlify.app/payment/dpo-callback
VITE_DPO_CANCEL_URL=https://farmconnect-eswatini.netlify.app/checkout
